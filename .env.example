# Optional: SQLite path for processing error logs (default: processing_errors.db)
# PROCESSING_ERRORS_DB=processing_errors.db

# Resend (https://resend.com) — email alerts on CSV processing errors
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=alerts@yourdomain.com
# ALERT_EMAIL=you@example.com

# Optional: base URL for Render logs (included in alert email)
# RENDER_LOGS_BASE_URL=https://dashboard.render.com/web/your-service/logs
